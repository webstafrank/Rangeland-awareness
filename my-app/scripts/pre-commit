#!/usr/bin/env bash
#
# Gate lane pre-commit hook.
#
# Runs only the fast, deterministic, free checks: the typechecker, the linter
# and the vitest gate suite. The Playwright eval lane is deliberately NOT here:
# it builds the app and drives a browser, which is minutes, and belongs before
# a push rather than on every commit.
#
# Install (from the repo root):
#   git config core.hooksPath my-app/scripts
#
# The path must be RELATIVE. core.hooksPath resolves a relative value against
# the top of the working tree being committed, so every worktree runs its own
# copy of this file. An absolute path into one checkout means every worktree
# runs that checkout's hook, and the cd below then validates a tree nobody is
# committing: the hook passes or fails on files that are not in the diff. That
# was a real failure, not a hypothetical one.

set -euo pipefail

# The tree being committed, not the tree this file happens to live in.
# --show-toplevel is worktree-aware; dirname "$BASH_SOURCE" is not, and is what
# made an absolute hooksPath silently check the wrong directory.
cd "$(git rev-parse --show-toplevel)/my-app"

echo "pre-commit: gate lane"

echo "  - typecheck"
# Via the npm script, so `next typegen` runs first. The generated route types
# under .next/types are gitignored, so a fresh clone or a new worktree has none
# and a bare `tsc --noEmit` fails on every PageProps in the app.
npm run --silent typecheck

echo "  - lint"
npx eslint .

echo "  - gate tests"
npx vitest run --silent

echo "pre-commit: green"
