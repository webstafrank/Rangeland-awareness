# Rangeland Awareness: the deployment environment.
#
#   cp .env.example .env
#   # fill in the five REQUIRED values (the four below plus GEOSERVER_URL), then:
#   docker compose up --build
#
# `docker compose` reads .env from this directory automatically. .env is
# gitignored (see the repo-root .gitignore) and excluded from both build
# contexts (.dockerignore), so nothing here reaches an image layer.
#
# NOTHING IN THIS FILE IS A REAL CREDENTIAL. Every value is a placeholder or an
# obvious example. If you ever paste a real secret in here, it is committed.
#
# Each line says what happens when the value is wrong, because "what breaks"
# is the only useful documentation for a variable you are guessing at.


# =============================================================================
# REQUIRED. Compose refuses to start without these; there is no default.
# GEOSERVER_URL, in the next section, is the fifth.
# =============================================================================

# Django's signing key. Generate a fresh one per deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Wrong (or left as the settings.py fallback "dev-only-not-a-secret"): anything
# Django signs can be forged by anyone who has read the source, which is
# everyone. Rotating it invalidates existing signed values, which here is
# nothing, so rotate freely.
DJANGO_SECRET_KEY=replace-me-with-64-random-characters

# Hostnames the BACKEND answers to. Comma separated, no scheme, no spaces, no
# port. Include the compose service name `backend`, because the web container's
# server-side calls arrive with `Host: backend:8000`.
# Wrong: every request gets HTTP 400 "Invalid HTTP_HOST header" and the app
# reports the backend as unreachable while the container looks perfectly
# healthy in `docker ps`.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origins the analyst's BROWSER loads the app from. Comma separated, WITH the
# scheme and the port, no trailing slash. This is the app's address, not the
# backend's.
# Wrong: the page renders, then every map tile and every run poll is blocked by
# the browser as a CORS failure. The map is blank and the only evidence is in
# the browser console.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# The backend URL as the BROWSER resolves it. This is baked into the JavaScript
# at BUILD time (Next inlines NEXT_PUBLIC_*), so changing it means
# `docker compose build web`, not a restart.
# Wrong, and specifically if you put the internal name `http://backend:8000`
# here: the server renders every page correctly, the browser hydrates, and then
# every client-side fetch goes to a hostname only the container network knows.
# Blank map, working page, no error on the server. This is the classic failure
# of this deployment.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# =============================================================================
# GEOSERVER. Where the layers come from. Not part of this compose file.
# =============================================================================

# Required in practice: compose will not start without it, because a backend
# pointed at the wrong GeoServer is indistinguishable from an empty one.
# Wrong: /api/v1/health reports `geoserver.reachable: false`, the layer
# catalogue is empty, and no run can start. Health tells you which URL it tried,
# which is how you find a typo here.
GEOSERVER_URL=http://192.168.0.40:8080/geoserver

# Optional. Leave both empty for an anonymous GeoServer. They stay server side;
# the browser never addresses GeoServer, so these are never exposed.
# Wrong: capabilities and tile requests come back 401 and the health check
# reports unreachable with the 401 in `detail`.
GEOSERVER_USER=
GEOSERVER_PASSWORD=

# Seconds. How long a GeoServer call may take before it is abandoned.
# Too low: a slow-but-working GetCapabilities (about 1s on the live server) is
# reported as down. Too high: every health check hangs for that long while
# GeoServer is off the network, and the container healthcheck timeout in
# Dockerfile.backend (40s) has to stay above it.
GEOSERVER_TIMEOUT=30

# Seconds. A coverage fetch is a whole GeoTIFF and is measured in tens of
# seconds, so it gets its own, much larger budget.
# Too low: long runs fail partway through a raster stage.
GEOSERVER_COVERAGE_TIMEOUT=300

# Seconds to cache the 258KB capabilities document.
# Too low: a quarter of a megabyte of XML is parsed in front of every map load.
# Too high: a layer published in GeoServer takes that long to appear in the app.
GEOSERVER_CAPABILITIES_TTL=300


# =============================================================================
# PORTS AND BINDING
# =============================================================================

# Host port for the app. Change it if 3000 is taken.
# Wrong: `docker compose up` fails with "port is already allocated". Note that
# changing it also means changing CORS_ALLOWED_ORIGINS to match, or the browser
# blocks every backend call.
WEB_PORT=3000

# Host port for the backend. The browser talks to this directly.
# Wrong: NEXT_PUBLIC_BACKEND_URL points at a port nothing is listening on, and
# every client-side call fails with a connection refused.
BACKEND_PORT=8000

# Which host interface each port binds to. 0.0.0.0 is every interface, which is
# what a shared server needs; 127.0.0.1 is this machine only.
# Wrong direction: 0.0.0.0 on a machine with a public address exposes a backend
# that has NO AUTHENTICATION of any kind. Put a reverse proxy with TLS in front
# of it and set these to 127.0.0.1 for anything beyond the office LAN.
WEB_BIND=0.0.0.0
BACKEND_BIND=0.0.0.0


# =============================================================================
# OPTIONAL. Sensible defaults; change only with a reason.
# =============================================================================

# Tags both images and is reported by /api/health, so you can tell which build
# is actually running. Use a git short sha or a release tag in a real deploy.
# Wrong: nothing breaks, you just cannot answer "which version is live".
APP_VERSION=dev

# Postgres instead of the default SQLite. Leave empty to use SQLite in the
# backend-data volume. settings.py switches on the `postgres` scheme.
# Wrong: a malformed URL falls back to SQLite silently, so a deployment that
# thinks it is on Postgres is writing to a volume nobody backs up.
DATABASE_URL=

# Gunicorn process and thread counts. One worker is the default on purpose: a
# run executes on a background THREAD inside the worker process, so more
# processes means more places a run can be living and more writers competing
# for one SQLite file.
# Wrong (raising workers on SQLite): "database is locked" errors during a run.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# Django's root log level: DEBUG, INFO, WARNING, ERROR.
# Wrong (DEBUG in production): every SQL query and every GeoServer URL, with
# query strings, in the container log.
LOG_LEVEL=INFO

# The app's WMS source override, for pointing the map at a different server
# than the built-in default. Both are NEXT_PUBLIC_*, so both are BUILD time:
# changing them needs `docker compose build web`.
# Wrong: the app reports the problem on the page rather than failing silently
# (services/wms/source.ts validates and collects problems), but the map draws
# the default source's layers.
NEXT_PUBLIC_WMS_SOURCE=
NEXT_PUBLIC_WMS_ENDPOINT=


# =============================================================================
# NOT SET HERE, AND WHY
# =============================================================================
#
# DJANGO_DEBUG   hardcoded to "0" in docker-compose.yml. A debug switch that can
#                be flipped by exporting a variable is one typo away from
#                serving stack traces and settings to the internet.
#
# CONTRACTS_DIR  unset. Dockerfile.backend mirrors the repository layout
#                (/app/contracts beside /app/services/backend), so settings.py
#                finds contracts/criteria.json on its own. Set it only if you
#                ship the contracts somewhere else.
#
# SQLITE_PATH,   set in docker-compose.yml to the two named volumes. They are
# RANGELAND_     not deployment choices, they are where the volumes are mounted,
# WORKSPACE      and changing one without changing the volume loses the data.
